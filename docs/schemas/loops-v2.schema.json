{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AGB versioned loop routing mirror",
  "type": "object",
  "required": [
    "schema",
    "approvals",
    "bindingFiles",
    "loops"
  ],
  "properties": {
    "schema": {
      "const": "agb/loops/v2"
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
      },
      "minItems": 0
    },
    "bindingFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "description": "Runtime additionally rejects traversal, absolute paths, backslashes, reserved names and symlinks."
      },
      "minItems": 1,
      "contains": {
        "const": "PROJECT_CONTRACT.md"
      }
    },
    "runtimeRoots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "description": "Runtime additionally rejects traversal, absolute paths, backslashes, reserved names and symlinks."
      },
      "minItems": 0
    },
    "acceptancePlan": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "description": "Runtime additionally rejects traversal, absolute paths, backslashes, reserved names and symlinks."
    },
    "loops": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "dependsOn",
          "approvals",
          "requirements",
          "acceptance",
          "independentReview"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "description": "Runtime additionally rejects traversal, absolute paths, backslashes, reserved names and symlinks."
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
            },
            "minItems": 0
          },
          "approvals": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
            },
            "minItems": 0
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
            },
            "minItems": 1
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "implemented",
                "functional",
                "visual"
              ]
            }
          },
          "independentReview": {
            "type": "boolean"
          },
          "fullCoverage": {
            "type": "boolean"
          },
          "productionStages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "preflight",
                "layout",
                "assembly",
                "static",
                "motion",
                "final"
              ]
            }
          },
          "skills": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "required",
              "optional"
            ],
            "properties": {
              "required": {
                "type": "array",
                "maxItems": 100,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"
                }
              },
              "optional": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "when"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"
                    },
                    "when": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    }
                  }
                }
              }
            },
            "description": "Requires skillRoot. IDs must be unique across required and optional. Optional skills are conditional suggestions, not automatic prerequisites."
          }
        }
      }
    },
    "productionEvidence": {
      "type": "object",
      "required": [
        "baseline",
        "receipts"
      ],
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "description": "Runtime additionally rejects traversal, absolute paths, backslashes, reserved names and symlinks."
        },
        "receipts": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "description": "Runtime additionally rejects traversal, absolute paths, backslashes, reserved names and symlinks."
        },
        "validationVersion": {
          "type": "integer",
          "enum": [
            1,
            2
          ],
          "description": "Optional reader policy. Omitted/1 preserves historical partial-plan behavior; 2 requires complete upstream production coverage and current artifact linkage. Not an upstream schema version."
        }
      }
    },
    "skillRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "description": "Optional project-relative installed skill directory containing README.md and <id>/SKILL.md; runtime rejects unsafe or symlinked paths."
    }
  },
  "description": "Dependencies must precede dependents. Runtime checks unknown IDs, included files and fullCoverage plan requirement."
}
