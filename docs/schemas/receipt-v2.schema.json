{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AGB receipt envelope (command-specific requirements enforced by CLI)",
  "type": "object",
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "const": "agb/receipt/v2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
    },
    "loop": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
    },
    "actor": {
      "type": "string",
      "minLength": 3,
      "maxLength": 12000
    },
    "basis": {
      "type": "string",
      "minLength": 3,
      "maxLength": 12000
    },
    "decision": {
      "enum": [
        "approved",
        "denied"
      ]
    },
    "contractSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "buildCommand": {
      "type": "string",
      "minLength": 3,
      "maxLength": 12000
    },
    "servedUrl": {
      "type": "string",
      "minLength": 3,
      "maxLength": 12000
    },
    "sourceToBuild": {
      "type": "string",
      "minLength": 3,
      "maxLength": 12000
    },
    "buildFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "description": "Runtime additionally rejects traversal, absolute paths, backslashes, reserved names and symlinks."
      },
      "minItems": 1
    },
    "runtimeFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "description": "Runtime additionally rejects traversal, absolute paths, backslashes, reserved names and symlinks."
      },
      "minItems": 1
    },
    "candidate": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "dimension": {
      "enum": [
        "implemented",
        "functional",
        "visual"
      ]
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "unverified"
      ]
    },
    "method": {
      "type": "string",
      "minLength": 3,
      "maxLength": 12000
    },
    "executedAt": {
      "type": [
        "string",
        "null"
      ],
      "description": "Null only for non-pass unexecuted records with explicit capabilityGap."
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement",
          "verdict",
          "observation"
        ],
        "properties": {
          "requirement": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "unverified"
            ]
          },
          "observation": {
            "type": "string",
            "minLength": 3,
            "maxLength": 12000
          },
          "views": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "verdict",
                "observation"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
                },
                "verdict": {
                  "enum": [
                    "pass",
                    "fail",
                    "unverified"
                  ]
                },
                "observation": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 12000
                }
              }
            },
            "minItems": 0
          }
        }
      },
      "minItems": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "kind",
          "observation"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "description": "Runtime additionally rejects traversal, absolute paths, backslashes, reserved names and symlinks."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "type": "string"
          },
          "observation": {
            "type": "string",
            "minLength": 3,
            "maxLength": 12000
          },
          "view": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
          }
        }
      },
      "minItems": 0,
      "maxItems": 100
    },
    "runningBuildObservation": {
      "type": "string",
      "minLength": 3,
      "maxLength": 12000
    },
    "viewportAndState": {
      "type": "string",
      "minLength": 3,
      "maxLength": 12000
    },
    "review": {
      "type": "object",
      "required": [
        "actor",
        "mode",
        "observation"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 3,
          "maxLength": 12000
        },
        "mode": {
          "enum": [
            "independent",
            "self",
            "unavailable"
          ]
        },
        "observation": {
          "type": "string",
          "minLength": 3,
          "maxLength": 12000
        }
      }
    },
    "evidence": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
          },
          "minItems": 1
        }
      ]
    },
    "description": {
      "type": "string",
      "minLength": 3,
      "maxLength": 12000
    },
    "fix": {
      "type": "string",
      "minLength": 3,
      "maxLength": 12000
    },
    "target": {
      "enum": [
        "alignment",
        "setup",
        "identity"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 3,
      "maxLength": 12000
    },
    "resolution": {
      "type": "string",
      "minLength": 3,
      "maxLength": 12000
    },
    "capabilityGap": {
      "type": "string",
      "minLength": 3,
      "maxLength": 12000
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
          },
          "description": {
            "type": "string",
            "minLength": 3,
            "maxLength": 12000
          }
        }
      }
    }
  },
  "description": "Use the $defs for command-specific fields. Receipts record claims, not authentication or executed proof. File hashes, freshness, coverage, dimensions and prerequisites are checked at runtime.",
  "allOf": [],
  "$defs": {
    "approve": {
      "required": [
        "schema",
        "id",
        "decision",
        "actor",
        "basis",
        "contractSha256"
      ]
    },
    "transition": {
      "required": [
        "schema",
        "loop"
      ]
    },
    "accept": {
      "required": [
        "schema",
        "loop",
        "evidence"
      ]
    },
    "bind": {
      "required": [
        "schema",
        "buildCommand",
        "servedUrl",
        "sourceToBuild",
        "buildFiles",
        "runtimeFiles"
      ]
    },
    "record": {
      "required": [
        "schema",
        "id",
        "loop",
        "candidate",
        "generation",
        "dimension",
        "verdict",
        "actor",
        "method",
        "executedAt",
        "coverage",
        "artifacts"
      ]
    },
    "visualRecord": {
      "required": [
        "schema",
        "runningBuildObservation",
        "viewportAndState",
        "review"
      ]
    },
    "defect": {
      "required": [
        "schema",
        "id",
        "loop",
        "dimension",
        "description"
      ]
    },
    "resolveDefect": {
      "required": [
        "schema",
        "id",
        "fix",
        "evidence"
      ]
    },
    "return": {
      "required": [
        "schema",
        "id",
        "loop",
        "target",
        "reason"
      ]
    },
    "resolveReturn": {
      "required": [
        "schema",
        "id",
        "resolution",
        "actor"
      ]
    }
  }
}
