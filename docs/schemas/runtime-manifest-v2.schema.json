{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AGB opt-in manifest extension",
  "type": "object",
  "required": [
    "slug",
    "files",
    "runtime"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "description": "Runtime additionally rejects traversal, absolute paths, backslashes, reserved names and symlinks."
          },
          {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "description": "Runtime additionally rejects traversal, absolute paths, backslashes, reserved names and symlinks."
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "url": {
                "type": "string"
              },
              "rawUrl": {
                "type": "string"
              },
              "siteUrl": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "schema",
        "definition"
      ],
      "properties": {
        "schema": {
          "const": "agb/runtime/v2"
        },
        "definition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "description": "Runtime additionally rejects traversal, absolute paths, backslashes, reserved names and symlinks."
        }
      }
    }
  },
  "description": "Remote v2 additionally requires out-of-band manifest SHA and sha256 on each payload; semantic/path/transport checks run in the CLI."
}
